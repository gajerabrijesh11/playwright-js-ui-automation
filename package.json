  "bugs": {
    "url": "https://github.com/gajerabrijesh11/playwright-js-ui-automation/issues"
  },
  "homepage": "https://github.com/gajerabrijesh11/playwright-js-ui-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "playwright-bdd": "^9.2.0"
  }
