{
  "name": "playwright-js-ui-automation",
  "version": "1.0.0",
  "description": "Only wbe  UI screens, Page Object Model (POM), and local test data handling",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:api": "playwright test --project=api_tests",
    "test:bdd": "playwright test --project=bdd-tests",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajerabrijesh11/playwright-js-ui-automation.git"
  },
